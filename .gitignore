.DS_Store
node_modules/
.vercel
public/
resources/
.hugo_build.lock
whitepaper/figures/.figure-1.boxes.json
.env*

# build-pdf scratch: the pandoc HTML and the paginated document
whitepaper/.build/
software-factory/.build/

# build-pdf renders here and then os.replace()s onto the tracked artifact, so the
# artifact is never absent. A hard kill — a CI timeout, the OOM killer — can still
# leave one of these behind; the next build sweeps them, and this keeps one out of
# a commit in the meantime.
static/.whitepaper.pdf.new-*
static/.software-factory.pdf.new-*

# Lighthouse CI reports, written by `npx @lhci/cli autorun` (lighthouserc.cjs).
.lighthouseci/
