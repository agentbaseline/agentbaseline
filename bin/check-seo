#!/usr/bin/env python3
"""Hold the built site to what search engines and agents are told about it.

Everything this reads is invisible on the page. A missing description, a
canonical that points at a redirect, a JSON-LD block with a stray comma, a
llms.txt link to a file that was renamed: each one renders nothing, raises
nothing, and passes every other gate here, because those read the prose. The
sitemap is the precedent — it advertised three addresses that answered 308 and
nobody saw it for months, because no person ever opens a sitemap. So this reads
public/ after `hugo --gc --minify`, the way a crawler would, and fails on what a
crawler would get wrong.

Every indexable page (any built .html that is not noindex):

  title        exactly one non-empty <title>. Two is a template that included
               its head twice; none is a page that is listed as its URL.
  description  a meta description of at least 50 characters, so the snippet is
               ours rather than whatever text a search engine scrapes from the
               page. Above 160 it is cut off in results — reported as a
               warning, not a failure, because a long one still says something.
  canonical    one, absolute, on the configured origin (https://agentbaseline.org),
               equal to og:url and listed in sitemap.xml. Three places name the
               page's address; when they disagree a crawler picks one and it is
               not always ours. The origin test also catches a public/ written by
               `hugo server`, which uses a localhost baseURL.
  social card  og:title, og:description, an absolute og:image with
               og:image:width and og:image:height, and twitter:card
               summary_large_image. Without the size a platform has to fetch the
               image before it can lay out the preview, and some do not wait.
  JSON-LD      at least one block; every block parses as JSON, names
               schema.org as its @context and has an @type. A block that does
               not parse is ignored without a word by everything that reads it.
               Every link in it to this site resolves to a built file.
  paper facts  each TechArticle states its own paper's version and date — the
               ones the paper's opening lines give — and its authors are the
               confirmed entries of the contributors.yaml beside the paper; its
               text version's header gives the same version and date. The paper
               is found through the article's text/markdown encoding, whose
               header names its source. Two papers share these templates, and
               one that inherits the other's version, date or byline still
               parses and still renders nothing a person sees.
  text version a <link rel="alternate" type="text/markdown"> whose href is a
               built, non-empty file on this site. Then the file itself: no
               relative link survives in it (it is served from the root, so a
               relative link means something different there than in the
               repository), every link to this site resolves to a built file,
               and vercel.json serves it as text/markdown with a Link header
               naming this page's canonical — hugo.toml and vercel.json both
               hold that pairing, and nothing else would notice them drift.

The 404 page: noindex, and no canonical or og:url. An error page that claims an
address can be indexed as that address.

sitemap.xml: every <loc> is on the origin and maps to a built file, and every
page it lists is indexable. The page rules above skip noindex pages, so this is
where an accidental noindex on / or /controls is caught.

vercel.json, for each text version: a single temporary redirect from its page's
path, conditioned on Accept: text/markdown, to the text version, and Vary:
Accept on the page — the third place, after hugo.toml and the headers, where a
page and its text version must agree. And every YAML file the site serves (the
catalogue, at /controls.yaml) is sent as text/yaml with its charset.

Links in a text version or llms.txt — inline, reference-style or raw src/href —
are absolute; links into the repository's main branch name files this checkout
has, and so do the repository URLs in the JSON-LD.

robots.txt: names the sitemap, at its absolute URL.

llms.txt: exists and parses as llmstxt.org describes it — the first line is the
H1 — and every link in it to this site resolves to a built file. Links
elsewhere (the repository) are counted and not fetched: this runs offline.
llms-full.txt exists, opens with an H1 and holds every text version, each under
the version and date its own header gives — the header the paper facts rule
holds to the paper.

Findings are printed, then a count; any finding exits non-zero. Warnings print
but do not fail.
"""
import html.parser, json, pathlib, re, sys
from urllib.parse import urlsplit

ROOT = pathlib.Path(__file__).resolve().parents[1]
PUBLIC = ROOT / "public"

cfg = (ROOT / "hugo.toml").read_text(encoding="utf-8")
m = re.search(r'^baseURL\s*=\s*"([^"]+)"', cfg, re.M)
if not m:
    sys.exit("no baseURL in hugo.toml — cannot tell which origin is ours, so this is a fail")
ORIGIN = m.group(1).rstrip("/")             # https://agentbaseline.org
_r = re.search(r'^\s*repo\s*=\s*"([^"]+)"', (ROOT / "hugo.toml").read_text(encoding="utf-8"), re.M)
REPO = _r.group(1).rstrip("/") if _r else ""  # https://github.com/agentbaseline/agentbaseline

if not (PUBLIC / "index.html").exists():
    # Not a pass. Every rule below reads the build; with no build they would all
    # find nothing wrong.
    sys.exit("public/index.html is missing — run `hugo --gc --minify` first")

findings, warnings = [], []


def find(where, msg):
    findings.append((where, msg))


def warn(where, msg):
    warnings.append((where, msg))


def built(url):
    """The built file a URL on our origin is served from, or None.

    Mirrors the deployment: cleanUrls serves /controls from controls/index.html
    (or controls.html), and a fragment or query never names a different file.
    """
    if not url.startswith(ORIGIN + "/") and url != ORIGIN:
        return None
    path = urlsplit(url).path or "/"
    rel = path.lstrip("/")
    for cand in (rel, f"{rel}/index.html", f"{rel}.html") if rel else ("index.html",):
        p = PUBLIC / cand
        if p.is_file():
            return p
    return None


class Head(html.parser.HTMLParser):
    """The machine-facing tags of one page: title, meta, link, JSON-LD."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.titles, self.meta, self.links, self.ldjson = [], [], [], []
        self._in = None
        self._buf = []
        self._svg = 0  # a <title> inside inline SVG names the drawing, not the page

    def handle_starttag(self, tag, attrs):
        a = {k: (v or "") for k, v in attrs}
        if tag == "svg":
            self._svg += 1
        elif tag == "title" and not self._svg:
            self._in, self._buf = "title", []
        elif tag == "script" and a.get("type", "").lower() == "application/ld+json":
            self._in, self._buf = "ld", []
        elif tag == "meta":
            self.meta.append(a)
        elif tag == "link":
            self.links.append(a)

    def handle_data(self, data):
        if self._in:
            self._buf.append(data)

    def handle_endtag(self, tag):
        if tag == "svg" and self._svg:
            self._svg -= 1
        elif tag == "title" and self._in == "title":
            self.titles.append("".join(self._buf).strip())
            self._in = None
        elif tag == "script" and self._in == "ld":
            self.ldjson.append("".join(self._buf))
            self._in = None


def parse(path):
    h = Head()
    h.feed(path.read_text(encoding="utf-8"))
    return h


def meta(h, key):
    """Every content value for a meta name= or property=."""
    return [m.get("content", "") for m in h.meta
            if m.get("name") == key or m.get("property") == key]


def rels(h, rel, **attrs):
    out = []
    for l in h.links:
        if rel in l.get("rel", "").lower().split() and all(l.get(k) == v for k, v in attrs.items()):
            out.append(l)
    return out


# ── sitemap.xml ──────────────────────────────────────────────────────────────
sitemap = PUBLIC / "sitemap.xml"
locs = []
if not sitemap.is_file():
    find("sitemap.xml", "missing")
else:
    locs = [l.strip() for l in re.findall(r"<loc>(.*?)</loc>", sitemap.read_text(encoding="utf-8"), re.S)]
    if not locs:
        find("sitemap.xml", "lists no URLs")
    for loc in locs:
        f = built(loc)
        if not f:
            find("sitemap.xml", f"{loc} maps to no built file")
        # A page the sitemap advertises must be one search engines may index.
        # The per-page rules below skip noindex pages, so without this an
        # accidental noindex on / or /controls — the costliest SEO regression
        # this site could ship — would pass in silence.
        elif f.suffix == ".html" and "noindex" in " ".join(meta(parse(f), "robots")).lower():
            find("sitemap.xml", f"{loc} is noindex — the sitemap may list only pages meant to be found")

# ── robots.txt ───────────────────────────────────────────────────────────────
robots = PUBLIC / "robots.txt"
want = f"{ORIGIN}/sitemap.xml"
if not robots.is_file():
    find("robots.txt", "missing")
elif not re.search(rf"^Sitemap:\s*{re.escape(want)}\s*$", robots.read_text(encoding="utf-8"), re.M | re.I):
    find("robots.txt", f"does not name the sitemap as `Sitemap: {want}`")

# ── vercel.json, for the text versions' headers ──────────────────────────────
try:
    vercel = json.loads((ROOT / "vercel.json").read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as e:
    vercel = {}
    find("vercel.json", f"unreadable: {e}")


def served_headers(path):
    """Headers vercel.json sets for an exact source path, lower-cased keys."""
    out = {}
    for rule in vercel.get("headers", []):
        if rule.get("source") == path:
            for hd in rule.get("headers", []):
                out[hd.get("key", "").lower()] = hd.get("value", "")
    return out


def repo_file_missing(url):
    """A link to a file on the repository's main branch names a path this
    checkout has. Checked offline: a rename in the repo breaks the link the
    same day, and nothing else would notice."""
    m = REPO and re.match(re.escape(REPO) + r"/(?:blob|raw)/main/([^#?]+)", url)
    return bool(m) and not (ROOT / m.group(1)).exists()


MONTHS = {m: i for i, m in enumerate(
    "January February March April May June July August September October November December".split(), 1)}


def paper_stated(md):
    """The version and ISO date a paper states in its opening lines, in either
    form this repository's papers use, or None. The same lines check-copy holds
    hugo.toml to and bin/build-pdf reads:

      Published as **Agent Baseline** · v1.0-draft · 30 July 2026 · …
      Version 1, October 13, 2026
    """
    head = "\n".join(md.splitlines()[:12])
    m = re.search(r"^Published as\b[^\n]*?·\s*v([0-9][^\s·]*)\s*·\s*(\d{1,2}) ([A-Z][a-z]+) (\d{4})", head, re.M)
    if m and m.group(3) in MONTHS:
        return m.group(1), f"{m.group(4)}-{MONTHS[m.group(3)]:02d}-{int(m.group(2)):02d}"
    m = re.search(r"^Version (\S+), ([A-Z][a-z]+) (\d{1,2}), (\d{4})$", head, re.M)
    if m and m.group(2) in MONTHS:
        return m.group(1), f"{m.group(4)}-{MONTHS[m.group(2)]:02d}-{int(m.group(3)):02d}"
    return None


def confirmed_names(path):
    """The names of the confirmed entries in a contributors.yaml, read without
    a YAML library (nothing here needs one): each entry is a `- ` item at the
    list's own indent, in flow (`- { name: …, confirmed: true }`) or block form.
    Nested lists, such as an entry's sections, sit deeper and stay inside it."""
    text = path.read_text(encoding="utf-8")
    m = re.search(r"^contributors:\s*\n(.*)", text, re.M | re.S)
    if not m:
        return None
    body = m.group(1)
    first = re.search(r"^([ \t]*)-\s", body, re.M)
    if not first:
        return []
    names = []
    for item in re.split(rf"^{first.group(1)}-\s", body, flags=re.M)[1:]:
        n = re.search(r"\bname:\s*([^,}\n#]+)", item)
        c = re.search(r"\bconfirmed:\s*(true|false)\b", item)
        if n and c and c.group(1) == "true":
            names.append(n.group(1).strip())
    return names


def header(path):
    """The quoted fields of a text version's YAML header, as a dict."""
    m = re.match(r"---\n(.*?)\n---\n", path.read_text(encoding="utf-8"), re.S)
    return dict(re.findall(r'^(\w+):\s*"([^"]*)"\s*$', m.group(1), re.M)) if m else {}


def check_article(where, i, node):
    """A TechArticle states its own paper's version, date and authors."""
    mds = [e.get("contentUrl", "") for e in node.get("encoding", []) if isinstance(e, dict)
           and e.get("encodingFormat") == "text/markdown"]
    f = built(mds[0]) if len(mds) == 1 else None
    if not f:
        find(where, f"JSON-LD block {i} (TechArticle) has no text/markdown encoding that is a "
                    f"built file, so its paper cannot be found to hold it to")
        return
    field = header(f).get
    src = field("source") or ""
    m = REPO and re.match(re.escape(REPO) + r"/blob/main/([^#?]+)$", src)
    paper = ROOT / m.group(1) if m else None
    if not (paper and paper.is_file()):
        find(where, f"JSON-LD block {i} (TechArticle): {f.name} names no source file in this "
                    f"checkout ({src or 'no source: line'})")
        return
    rel = paper.relative_to(ROOT).as_posix()
    stated = paper_stated(paper.read_text(encoding="utf-8"))
    if not stated:
        find(where, f"JSON-LD block {i} (TechArticle): {rel} states no version and date in its "
                    f"opening lines, so there is nothing to hold the JSON-LD to")
    else:
        version, date = stated
        for key, want in (("version", version), ("datePublished", date)):
            if node.get(key) != want:
                find(where, f"JSON-LD block {i} (TechArticle) has {key} {node.get(key)!r}; "
                            f"{rel} says {want!r}")
        for key, want in (("version", version), ("published", date)):
            if field(key) != want:
                find(f.name, f"header {key} is {field(key)!r}; {rel} says {want!r}")
    people = paper.parent / "contributors.yaml"
    names = confirmed_names(people) if people.is_file() else None
    if names is None:
        find(where, f"JSON-LD block {i} (TechArticle): no contributors list in "
                    f"{people.relative_to(ROOT).as_posix()} to hold its authors to")
        return
    got = [a.get("name") for a in node.get("author", []) if isinstance(a, dict)]
    if sorted(got) != sorted(names):
        find(where, f"JSON-LD block {i} (TechArticle) names {len(got)} author(s), not the "
                    f"{len(names)} {people.relative_to(ROOT).as_posix()} confirms — missing "
                    f"{sorted(set(names) - set(got)) or 'none'}, extra {sorted(set(got) - set(names)) or 'none'}")


def text_links(where, path):
    """A text version (or llms.txt) may hold only absolute links and fragments,
    and every link to this site must resolve. Inline links, reference-style
    definitions and raw src/href attributes all count — the template rewrites
    only inline ones, so the others are exactly the links that would ship
    relative. Returns (ours, elsewhere)."""
    text = path.read_text(encoding="utf-8")
    ours = elsewhere = 0
    targets = (re.findall(r"\]\(([^)\s]+)", text)
               + re.findall(r"^\s*\[[^\]]+\]:\s*(\S+)", text, re.M)
               + re.findall(r"""(?:src|href)=["']([^"']+)["']""", text))
    for target in targets:
        if target.startswith("#") or target.startswith("mailto:"):
            continue
        if not re.match(r"[a-zA-Z][a-zA-Z0-9+.-]*:", target):
            find(where, f"relative link `{target}` — it resolves against the site root, "
                        f"not the directory it was written in")
        elif target.startswith(ORIGIN):
            ours += 1
            if not built(target):
                find(where, f"{target} resolves to no built file")
        else:
            elsewhere += 1
            if repo_file_missing(target):
                find(where, f"{target} names a file the repository does not have")
    return ours, elsewhere


# ── every page ───────────────────────────────────────────────────────────────
pages = [p for p in sorted(PUBLIC.rglob("*.html")) if p.name != "404.html"]
texts = articles = 0
text_files = set()
for p in pages:
    where = p.relative_to(PUBLIC).as_posix()
    h = parse(p)
    robots_meta = " ".join(meta(h, "robots")).lower()
    if "noindex" in robots_meta:
        continue                                    # not an indexable page

    if len(h.titles) != 1 or not h.titles[0]:
        find(where, f"{len(h.titles)} <title> element(s); want exactly one, non-empty")

    desc = meta(h, "description")
    if len(desc) != 1:
        find(where, f"{len(desc)} meta description(s); want exactly one")
    elif len(desc[0]) < 50:
        find(where, f"meta description is {len(desc[0])} characters; want at least 50")
    elif len(desc[0]) > 160:
        warn(where, f"meta description is {len(desc[0])} characters; results cut it at about 160")

    canon = [l.get("href", "") for l in rels(h, "canonical")]
    ogurl = meta(h, "og:url")
    if len(canon) != 1:
        find(where, f"{len(canon)} canonical link(s); want exactly one")
    else:
        c = canon[0]
        if not (c == ORIGIN + "/" or c.startswith(ORIGIN + "/")):
            find(where, f"canonical {c} is not on {ORIGIN}")
        if ogurl != [c]:
            find(where, f"og:url {ogurl or 'missing'} does not equal canonical {c}")
        if locs and c not in locs:
            find(where, f"canonical {c} is not listed in sitemap.xml")

    for key in ("og:title", "og:description"):
        if not [v for v in meta(h, key) if v.strip()]:
            find(where, f"no {key}")
    img = meta(h, "og:image")
    if not img or not re.match(r"https://", img[0]):
        find(where, f"og:image {img or 'missing'} is not an absolute https URL")
    for key in ("og:image:width", "og:image:height"):
        if not [v for v in meta(h, key) if v.isdigit()]:
            find(where, f"no numeric {key}")
    if meta(h, "twitter:card") != ["summary_large_image"]:
        find(where, f"twitter:card is {meta(h, 'twitter:card') or 'missing'}; want summary_large_image")

    if not h.ldjson:
        find(where, "no JSON-LD")
    for i, raw in enumerate(h.ldjson, 1):
        try:
            ld = json.loads(raw)
        except json.JSONDecodeError as e:
            find(where, f"JSON-LD block {i} does not parse: {e}")
            continue
        nodes = ld if isinstance(ld, list) else [ld]
        if not nodes:
            find(where, f"JSON-LD block {i} is empty")
        stack = [ld]
        while stack:
            v = stack.pop()
            if isinstance(v, dict):
                stack.extend(v.values())
            elif isinstance(v, list):
                stack.extend(v)
            elif isinstance(v, str) and repo_file_missing(v):
                find(where, f"JSON-LD block {i} links {v}, a file the repository does not have")
            elif isinstance(v, str) and (v == ORIGIN or v.startswith(ORIGIN + "/")) and not built(v):
                find(where, f"JSON-LD block {i} links {v}, which resolves to no built file")
        for node in nodes:
            ctx = node.get("@context") if isinstance(node, dict) else None
            if not (isinstance(ctx, str) and re.fullmatch(r"https?://schema\.org/?", ctx)):
                find(where, f"JSON-LD block {i} has @context {ctx!r}; want https://schema.org")
            if not (isinstance(node, dict) and node.get("@type")):
                find(where, f"JSON-LD block {i} has no @type")
            elif node.get("@type") == "TechArticle":
                articles += 1
                check_article(where, i, node)

    alts = rels(h, "alternate", type="text/markdown")
    if not alts:
        find(where, 'no <link rel="alternate" type="text/markdown"> to a text version')
    for a in alts:
        href = a.get("href", "")
        f = built(href)
        if not f:
            find(where, f"text version {href or '(no href)'} is not a built file on {ORIGIN}")
            continue
        texts += 1
        text_files.add(f)
        tw = f.relative_to(PUBLIC).as_posix()
        if f.stat().st_size == 0:
            find(tw, "empty")
        text_links(tw, f)
        path = "/" + tw
        hd = served_headers(path)
        if not re.fullmatch(r"text/markdown;\s*charset=utf-8", hd.get("content-type", ""), re.I):
            find("vercel.json", f"{path} is not served as `text/markdown; charset=utf-8` — without "
                                f"the charset a browser guesses, and an en dash reads as mojibake")
        if len(canon) == 1 and hd.get("link") != f'<{canon[0]}>; rel="canonical"':
            find("vercel.json", f"{path} has Link {hd.get('link')!r}; want "
                                f"'<{canon[0]}>; rel=\"canonical\"', the canonical of {where}")
        # A client that asks the page for Markdown is sent to this file: one
        # temporary redirect from the page's own path, conditioned on Accept,
        # and Vary: Accept on the page so a cache never hands the redirect to
        # a browser. The third place, after hugo.toml and the headers above,
        # where the page and its text version must agree.
        if len(canon) == 1 and canon[0].startswith(ORIGIN):
            src = canon[0][len(ORIGIN):] or "/"
            reds = [r for r in vercel.get("redirects", []) if r.get("source") == src
                    and any(c.get("type") == "header" and c.get("key", "").lower() == "accept"
                            and "text/markdown" in json.dumps(c.get("value", "")) for c in r.get("has", []))]
            if len(reds) != 1:
                find("vercel.json", f"{len(reds)} Accept: text/markdown redirect(s) from {src}; want one")
            else:
                if reds[0].get("destination") != path:
                    find("vercel.json", f"the Markdown redirect from {src} goes to "
                                        f"{reds[0].get('destination')!r}; want {path!r}")
                if reds[0].get("permanent") is not False:
                    find("vercel.json", f"the Markdown redirect from {src} is not `permanent: false`"
                                        f" — a permanent one would be cached for browsers too")
            if "accept" not in served_headers(src).get("vary", "").lower():
                find("vercel.json", f"{src} does not send Vary: Accept")

# ── the 404 page ─────────────────────────────────────────────────────────────
nf = PUBLIC / "404.html"
if not nf.is_file():
    find("404.html", "missing")
else:
    h = parse(nf)
    if "noindex" not in " ".join(meta(h, "robots")).lower():
        find("404.html", "not noindex")
    if rels(h, "canonical"):
        find("404.html", "declares a canonical")
    if meta(h, "og:url"):
        find("404.html", "declares an og:url")

# ── llms.txt and llms-full.txt ───────────────────────────────────────────────
llms = PUBLIC / "llms.txt"
off = 0
if not llms.is_file():
    find("llms.txt", "missing")
else:
    lines = llms.read_text(encoding="utf-8").splitlines()
    if not lines or not re.match(r"# \S", lines[0]):
        find("llms.txt", "does not open with an H1 (`# Name`) — llmstxt.org requires it first")
    # An H2 section is a list of links, each `- [name](url)` with an optional
    # `: note`. A line in one that is neither is a list item an agent cannot use.
    section = None
    for n, line in enumerate(lines, 1):
        if line.startswith("## "):
            section = line[3:].strip()
        elif section and line.strip() and not re.match(r"- \[[^\]]+\]\([^)\s]+\)(: .+)?$", line):
            find("llms.txt", f"line {n} in section {section!r} is not `- [name](url): note`")
    if section is None:
        find("llms.txt", "has no H2 section of links")
    ours, off = text_links("llms.txt", llms)
    if not ours:
        find("llms.txt", "links to nothing on this site")
# Both files are UTF-8 with dashes and curly quotes in them. Vercel happens to
# add charset=utf-8 to .txt today; naming it means a default changing, or a
# local preview server, cannot turn an en dash into mojibake for an agent.
for name in ("llms.txt", "llms-full.txt"):
    if not re.fullmatch(r"text/plain;\s*charset=utf-8", served_headers(f"/{name}").get("content-type", ""), re.I):
        find("vercel.json", f"/{name} is not served as `text/plain; charset=utf-8`")
# The catalogue is a file of its own, linked from llms.txt and the JSON-LD.
# text/yaml is what makes a browser show it rather than save it, and the
# charset keeps its dashes readable.
for y in sorted([*PUBLIC.rglob("*.yaml"), *PUBLIC.rglob("*.yml")]):
    path = "/" + y.relative_to(PUBLIC).as_posix()
    if not re.fullmatch(r"text/yaml;\s*charset=utf-8", served_headers(path).get("content-type", ""), re.I):
        find("vercel.json", f"{path} is not served as `text/yaml; charset=utf-8`")
full = PUBLIC / "llms-full.txt"
if not full.is_file() or not re.match(r"# \S", full.read_text(encoding="utf-8")):
    find("llms-full.txt", "missing, or does not open with an H1")
else:
    # Each document opens on a short list of its text version's header fields.
    # The version and date there are a third statement of them, after the
    # header and the JSON-LD, and one left with the baseline's after a paper
    # got its own would still read as fact.
    held = set()
    for m in re.finditer(r"^\* \* \*\n\n- Source: (\S+)\n((?:- [^\n]*\n)*)",
                         full.read_text(encoding="utf-8"), re.M):
        f = built(m.group(1))
        if not f:
            find("llms-full.txt", f"Source {m.group(1)} resolves to no built file")
            continue
        held.add(f)
        facts = dict(re.findall(r"^- ([^:\n]+): (.*)$", m.group(2), re.M))
        hdr = header(f)
        if not facts.get("Version") or facts["Version"] != hdr.get("version"):
            find("llms-full.txt", f"{f.name} is given as Version {facts.get('Version')!r}; "
                                  f"its header says {hdr.get('version')!r}")
        d = re.fullmatch(r"(\d{1,2}) ([A-Z][a-z]+) (\d{4})", facts.get("Published", ""))
        iso = d and d.group(2) in MONTHS and f"{d.group(3)}-{MONTHS[d.group(2)]:02d}-{int(d.group(1)):02d}"
        if not iso or iso != hdr.get("published"):
            find("llms-full.txt", f"{f.name} is given as Published {facts.get('Published')!r}; "
                                  f"its header says {hdr.get('published')!r}")
    for f in sorted(text_files - held):
        find("llms-full.txt", f"holds no `- Source:` entry for {f.relative_to(PUBLIC).as_posix()}")

for where, msg in findings:
    print(f"  FAIL  {where}: {msg}")
for where, msg in warnings:
    print(f"  warn  {where}: {msg}")
print(f"\nseo: {len(pages)} page(s) · {texts} text version(s) · {articles} paper(s) held to "
      f"their source · {len(locs)} sitemap URL(s) · {off} off-site llms.txt link(s) not fetched")
print(f"\n{len(findings)} finding(s), {len(warnings)} warning(s)")
sys.exit(1 if findings else 0)
