#!/usr/bin/env python3
"""
Enforce the controls's own rules. Every promise this repository makes in prose
is checked here, because a rule that lives only in Markdown holds exactly as well
as it holds today.

Run:  bin/check-controls          errors exit 1
      bin/check-controls --warn   report only, always exit 0
"""
import re, sys, pathlib, collections

ROOT = pathlib.Path(__file__).resolve().parents[1]
CAT  = ROOT / "whitepaper" / "controls.yaml"
PAPER = ROOT / "whitepaper" / "whitepaper.md"

errors, warnings = [], []
def err(m): errors.append(m)
def warn(m): warnings.append(m)

src = CAT.read_text(encoding="utf-8")

# ── parse ─────────────────────────────────────────────────────────────────────
blocks = re.split(r"\n(?=  - id: )", src.split("controls:", 1)[1]) if "controls:" in src else []
controls = []
for b in blocks:
    m = re.search(r"- id: (\S+)", b)
    if not m: continue
    controls.append({
        "id": m.group(1),
        "title": (re.search(r'title: "(.*)"', b) or [None, None])[1],
        "outcome": (re.search(r"outcome: (\S+)", b) or [None, None])[1],
        "status": (re.search(r"status: (\S+)", b) or [None, None])[1],
        "requirement": " ".join(
            (re.search(r"requirement: >-\n((?:     .*\n?)+)", b) or [None, ""])[1].split()),
        "evidence": bool(re.search(r"^    evidence:", b, re.M)),
        "raw": b,
    })
outcomes = re.findall(r"^  - prefix: (\w+)$", src, re.M)

if not controls: err("no controls parsed from controls.yaml")
if not outcomes: err("no outcomes parsed from controls.yaml")

fam_alt = "|".join(outcomes) or "DIS|AUT|CON|VAL|OBS|RES"
hi_by_fam = {}
for c in controls:
    f_, n_ = c["id"].split("-")[0], int(c["id"].split("-")[1])
    hi_by_fam[f_] = max(hi_by_fam.get(f_, 0), n_)

# ── 1. identifiers carry no project name  (ADR-0001) ──────────────────────────
for c in controls:
    if not re.fullmatch(rf"({fam_alt})-\d{{2}}", c["id"]):
        err(f"{c['id']}: identifier must be bare FAMILY-NN — no project prefix (ADR-0001)")
body = "\n".join(l for l in src.splitlines() if not l.lstrip().startswith("#"))
stray = re.findall(rf"\b[A-Z]{{2,5}}-(?:{fam_alt})-\d{{2}}\b", body)
if stray:
    err(f"controls.yaml: {len(stray)} prefixed identifier(s) e.g. {stray[0]} — ADR-0001 forbids this")

# ── 2. no duplicate identifiers, no identifier meaning two things ─────────────
for cid, group in collections.Counter(c["id"] for c in controls).items():
    if group > 1: err(f"{cid}: appears {group} times")

# ── 3. requirement strings are clean prose ────────────────────────────────────
for c in controls:
    r = c["requirement"]
    if not r:
        err(f"{c['id']}: empty requirement")
        continue
    if re.search(r"#{1,6}\s", r) or r.rstrip().endswith("#"):
        err(f"{c['id']}: markdown heading leaked into the requirement — {r[-46:]!r}")
    if not r.rstrip().endswith("."):
        warn(f"{c['id']}: requirement does not end in a full stop")
    for hedge in (" appropriate", " sufficient", " where available", " as needed"):
        if hedge in r.lower():
            warn(f"{c['id']}: unquantified hedge '{hedge.strip()}' — an auditor cannot test this")

# ── 4. required fields ────────────────────────────────────────────────────────
for c in controls:
    for f in ("title", "outcome", "status"):
        if not c[f]: err(f"{c['id']}: missing `{f}`")
    if c["outcome"] and c["id"].split("-")[0] != c["outcome"]:
        err(f"{c['id']}: outcome `{c['outcome']}` disagrees with the identifier family")

# ── 5. every control carries an evidence line ─────────────────────────────────
# CONTRIBUTING.md: "If you cannot write the evidence line, the control is not
# ready. That rule applies to the founding maintainers too."
missing = [c["id"] for c in controls if not c["evidence"]]
if missing:
    # TRACKED as issue #1. A permanently-red required check trains people to
    # ignore it; this stays loud but does not block.
    warn(f"{len(missing)}/{len(controls)} controls have no `evidence:` line — "
        f"CONTRIBUTING.md requires one on every control "
        f"(first: {', '.join(missing[:5])}{'…' if len(missing) > 5 else ''})")

# ── 6. the paper may not disagree with the controls ──────────────────────────
if PAPER.exists():
    ptext = PAPER.read_text(encoding="utf-8")
    if re.search(rf"\b[A-Z]{{2,5}}-(?:{fam_alt})-\d{{2}}\b", ptext):
        err("whitepaper.md: prefixed identifiers present — ADR-0001 forbids this")
    if "NOTE (internal" in ptext or "GTM" in ptext:
        err("whitepaper.md: an internal note is present in a published document")
    paper_ids = set(re.findall(rf"\b(({fam_alt})-\d{{2}})\b", ptext))
    cat_ids = {c["id"] for c in controls}
    paper_ids = {p[0] if isinstance(p, tuple) else p for p in paper_ids}
    for extra in sorted(paper_ids - cat_ids):
        # TRACKED as issue #1: the Section 5 / Appendix A divergence. Needs an
        # author's ruling, not a merge.
        warn(f"{extra}: cited in whitepaper.md but absent from controls.yaml "
             f"(issue #1)")

# ── 7. built output must agree with the source of truth ──────────────────────
# Asserts the rendered ranges rather than grepping for the shape of a past bug.
built = ROOT / "public" / "index.html"
if built.exists():
    html = built.read_text(encoding="utf-8")
    for fam, n in sorted(hi_by_fam.items()):
        for m in re.finditer(rf"{fam}-(\d{{2}})…(\d{{2}})", html):
            if int(m.group(2)) != n:
                err(f"{fam}: page publishes range …{m.group(2)}, controls.yaml "
                    f"has {n:02d} as the highest identifier")

# ── report ────────────────────────────────────────────────────────────────────
fam = collections.Counter(c["id"].split("-")[0] for c in controls)
print(f"controls: {len(controls)} controls across {len(outcomes)} outcomes  "
      f"({', '.join(f'{k} {v}' for k, v in fam.items())})")
for w in warnings: print(f"  warn   {w}")
for e in errors:   print(f"  ERROR  {e}")
print(f"\n{len(errors)} error(s), {len(warnings)} warning(s)")
sys.exit(1 if errors and "--warn" not in sys.argv else 0)
