#!/usr/bin/env bash
# Freeze the current build as a numbered pass so passes can be compared.
set -euo pipefail
cd "$(dirname "$0")/.."
N="${1:?usage: bin/snapshot <n> <label>}"; shift
LABEL="${*:-untitled}"
python3 whitepaper/figures/build-figure-1.py >/dev/null
python3 - <<'P'
import re,pathlib
s=pathlib.Path("whitepaper/figures/figure-1.svg").read_text()
pathlib.Path("layouts/partials/figure-1.svg").write_text(re.sub(r"\swidth=\"\\d+\"\\s+height=\"\\d+\"","",s,count=1))
P
hugo --gc --minify --quiet
mkdir -p "docs/passes/v$N"
cp public/index.html "docs/passes/v$N/index.html"
cp public/controls/index.html "docs/passes/v$N/controls.html" 2>/dev/null || true
cp whitepaper/figures/figure-1.svg "docs/passes/v$N/figure-1.svg"
printf '%s\n' "$LABEL" > "docs/passes/v$N/LABEL"
echo "pass v$N — $LABEL"
echo "  page   $(wc -c < docs/passes/v$N/index.html | tr -d ' ') bytes"
echo "  figure $(wc -c < docs/passes/v$N/figure-1.svg | tr -d ' ') bytes"
python3 bin/build-passes
