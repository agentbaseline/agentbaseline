#!/usr/bin/env python3
"""Render static/whitepaper.pdf from whitepaper.md and controls.yaml.

Markdown -> HTML via pandoc, paginated by Paged.js, printed by Chrome.
Deliberately not LaTeX: the PDF embeds the site's own woff2 files, so the page,
the PDF and the social card are one artifact rather than three that resemble
each other.

Three things the previous version got wrong, all visible in the shipped file:

  * It claimed to inherit the site's typography and did not — it named Charter
    and Menlo, which are not on this site, so the PDF embedded system fonts and
    read like a word-processor export.
  * It passed --no-pdf-header-footer, so a 27-page citable document had no page
    numbers at all, and its contents page was a list of blue underlined links
    with nothing to look up.
  * It rendered Appendix A from the paper's five-column Markdown table. Four of
    those columns hold one to three words and the fifth holds a paragraph, so
    the description was squeezed to about three words a line and ran twenty
    lines tall beside four empty cells. Worse, rows broke across pages and the
    identifier column went blank, so a continued description could not be
    attributed to any control — a correctness failure in a reference appendix.

The appendix is now generated from controls.yaml, which is the source of truth
and which check-appendix proves still agrees with the paper's own table.

Two properties this script owes its callers, both learned the hard way:

  * The tracked file is never absent. It used to unlink static/whitepaper.pdf and
    then spend several seconds in Chrome, so a Ctrl-C, a CI step timeout or an
    OOM in that window left the repository with no deliverable at all. The render
    now goes to a sibling temporary file and is moved into place with os.replace,
    which is atomic on the same filesystem: at every instant the path either holds
    the old PDF or the new one.
  * It records what it built from. `--provenance` writes the digest of every file
    the render actually read, the digest of the PDF it produced, and the browser
    that produced it. bin/check-pdf-current then answers "is the committed artifact
    the one this source makes?" on any machine, with no browser and no pandoc,
    which is what lets the question be asked in CI on every pull request rather
    than remembered by whoever last touched the paper.
"""
import argparse, pathlib, subprocess, sys, shutil, re, base64, hashlib, html, json, os, calendar, datetime, urllib.request

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import controls_source

ROOT = pathlib.Path(__file__).resolve().parents[1]
SRC = ROOT / "whitepaper" / "whitepaper.md"
OUT = ROOT / "static" / "whitepaper.pdf"
PROVENANCE = ROOT / "whitepaper" / "pdf.provenance.json"
WORK = ROOT / "whitepaper" / ".build"
PAGED = ROOT / "bin" / "vendor" / "paged.polyfill.js"

# ── what this build read ─────────────────────────────────────────────────────
# Recorded as the files are opened rather than listed by hand. A hand-written
# list of inputs is a second source of truth about the build, and it goes stale
# the first time someone adds a figure: the manifest would still describe the
# render as current while the render had changed. Anything the build reads is in
# here because reading it is what puts it here.
INPUTS = {}

def rel(path):
    """A path as the repo names it, or as itself if it is outside the repo.

    `--out` is routinely given a scratch path in /tmp — that is the whole reason
    it exists — so nothing here may assume a path is under ROOT.
    """
    p = pathlib.Path(path).resolve()
    return p.relative_to(ROOT).as_posix() if ROOT in p.parents else str(p)


def record(path):
    """Hash a file into the manifest and return its path."""
    p = pathlib.Path(path).resolve()
    INPUTS[rel(p)] = hashlib.sha256(p.read_bytes()).hexdigest()
    return p

for tool in ("pandoc",):
    if not shutil.which(tool):
        sys.exit(f"{tool} is not installed")
if not PAGED.exists():
    sys.exit(f"missing {PAGED.relative_to(ROOT)} — see bin/vendor/README.md")

# ── the catalogue ────────────────────────────────────────────────────────────
# A tolerant reader rather than a schema-shaped regex. The previous attempt at
# this pinned the field order and silently matched zero controls when a new
# `type:` field was inserted, which is the failure mode to avoid in the script
# that renders the reference appendix.
#
# The reader itself now lives in bin/controls_source.py, because check-appendix
# proves this appendix against the paper using the same file and the two had
# drifted into different regexes. Its own copy read a folded scalar as "every
# indented line that follows", which swallowed the next sibling key, and
# recognised only `>-` of the six block-scalar indicators.
#
# The count it reports on the cover is the count the social card and the page
# report, because control_ids() is the one that answers that question. This
# script used to accept any block carrying an `id:` in any shape, so it could
# print a number the card and the og:image did not have.
def load_controls():
    record(ROOT / "whitepaper" / "controls.yaml")
    outcomes, controls = controls_source.load()
    if not outcomes or not controls:
        sys.exit("could not read controls.yaml — refusing to render an empty appendix")
    controls_source.control_ids()
    return outcomes, controls

OUTCOMES, CONTROLS = load_controls()

# ── the paper ────────────────────────────────────────────────────────────────
md = record(SRC).read_text(encoding="utf-8")

def cut_section(text, heading_re):
    """Remove one `# Heading` block, up to the next level-1 heading."""
    m = re.search(heading_re, text, re.M)
    if not m:
        return text, ""
    nxt = re.search(r"^# ", text[m.end():], re.M)
    end = m.end() + (nxt.start() if nxt else len(text) - m.end())
    return text[:m.start()] + text[end:], text[m.start():end]

# The paper's hand-written contents is a flat list of links. It is useful on
# GitHub and useless in print, where a link with no page number cannot be
# followed. Dropped here and rebuilt below with real page references.
md, _ = cut_section(md, r"^# Contents\b.*$")
# Appendix A is regenerated from controls.yaml.
md, _ = cut_section(md, r"^# Appendix A\b.*$")

WORK.mkdir(exist_ok=True)
(WORK / "paper.md").write_text(md, encoding="utf-8")
body = subprocess.run(
    ["pandoc", str(WORK / "paper.md"), "-t", "html5", "--no-highlight"],
    capture_output=True, text=True, check=True).stdout

# The paper opens with a title, a subtitle and two published lines. All four
# are the cover's job. Left in the flow they do not simply repeat the cover —
# they land orphaned at the foot of the contents page, under the leaders.
body = re.sub(r"^\s*<h1[^>]*>.*?</h1>", "", body, count=1, flags=re.S)
for _ in range(2):
    body = re.sub(r"^\s*<p>(?:(?!</p>).)*?(?:Identify the agent|Published as).*?</p>",
                  "", body, count=1, flags=re.S)

# Images are written relative to the markdown; the build directory is one level
# down, so every one of them resolved to nothing and printed as a broken-image
# glyph. Absolute file URLs, resolved against the paper's own directory.
body = re.sub(r'(<img[^>]+src=")([^":]+)(")',
              lambda m: m.group(1) + (SRC.parent / m.group(2)).resolve().as_uri() + m.group(3),
              body)

# ── contents, with page numbers resolved by Paged.js ─────────────────────────
toc = []
for m in re.finditer(r'<h([12])\s+id="([^"]+)"[^>]*>(.*?)</h\1>', body, re.S):
    lvl, anchor, label = m.group(1), m.group(2), re.sub(r"<[^>]+>", "", m.group(3))
    label = html.unescape(label).strip()
    if label:
        toc.append((lvl, anchor, label))
toc.append(("1", "appendix-a", "Appendix A. Canonical capability map"))
toc_html = "\n".join(
    f'<li class="l{lvl}"><a href="#{a}"><span class="t">{html.escape(l)}</span></a></li>'
    for lvl, a, l in toc)

# ── the appendix, as blocks rather than a table ──────────────────────────────
by_outcome = {}
for c in CONTROLS:
    by_outcome.setdefault(c["outcome"], []).append(c)
app = []
for o in OUTCOMES:
    rows = by_outcome.get(o["prefix"], [])
    if not rows:
        continue
    ids = f'{rows[0]["id"]}–{rows[-1]["id"]}'
    app.append(f'<section class="fam">'
               f'<h2 id="app-{o["prefix"].lower()}">{html.escape(o["name"])}'
               f'<span class="span">{ids}</span></h2>'
               f'<p class="famreq">{html.escape(o["requirement"] or "")}</p>')
    for c in rows:
        app.append(
            f'<div class="ctl" id="{c["id"]}">'
            f'<div class="cid">{c["id"]}</div>'
            f'<div class="cbody"><div class="chead">'
            f'<span class="ctitle">{html.escape(c["title"] or "")}</span>'
            f'<span class="ctype">{html.escape(c["type"] or "")}</span></div>'
            f'<p class="creq">{html.escape(c["requirement"] or "")}</p></div></div>')
    app.append("</section>")
appendix_html = "\n".join(app)

# ── fonts, embedded so the print engine cannot fall back silently ────────────
FACES = [
    ("IBM Plex Serif", 400, "normal", "ibm-plex-serif-normal-400-latin.woff2"),
    ("IBM Plex Serif", 400, "italic", "ibm-plex-serif-italic-400-latin.woff2"),
    ("IBM Plex Serif", 600, "normal", "ibm-plex-serif-normal-600-latin.woff2"),
    ("IBM Plex Serif", 700, "normal", "ibm-plex-serif-normal-700-latin.woff2"),
    ("Figtree",        400, "normal", "figtree-normal-400-latin.woff2"),
    ("Figtree",        500, "normal", "figtree-normal-400-latin.woff2"),
    ("Figtree",        600, "normal", "figtree-normal-400-latin.woff2"),
    ("Figtree",        400, "italic", "figtree-italic-400-latin.woff2"),
    ("Chakra Petch",   500, "normal", "chakra-petch-normal-500-latin.woff2"),
    ("Chakra Petch",   600, "normal", "chakra-petch-normal-600-latin.woff2"),
    ("IBM Plex Mono",  400, "normal", "ibm-plex-mono-normal-400-latin.woff2"),
    ("IBM Plex Mono",  600, "normal", "ibm-plex-mono-normal-600-latin.woff2"),
]
faces = []
for fam, wt, style, fn in FACES:
    f = ROOT / "static" / "fonts" / fn
    if not f.exists():
        sys.exit(f"missing font {fn} — the PDF must not fall back to a system face")
    b64 = base64.b64encode(record(f).read_bytes()).decode()
    faces.append(f'@font-face{{font-family:"{fam}";font-weight:{wt};'
                 f'font-style:{style};font-display:block;'
                 f'src:url(data:font/woff2;base64,{b64}) format("woff2")}}')
FONTS = "\n".join(faces)

# figtree-normal-400-latin.woff2 is a variable font (fvar/gvar, wght 300-900),
# so every weight below is a real instance cut from the one file rather than a
# synthesised bold. The filename says 400 and means "the 400 named instance is
# the default" — it is not the only weight in there.
CSS = """
@page {
  size: A4; margin: 22mm 30mm 20mm;
  @bottom-left  { content: "Agent Baseline"; font-family:"IBM Plex Mono",monospace;
                  font-size:7.5pt; letter-spacing:.06em; color:#8C8878; }
  @bottom-center{ content: "v@VERSION@ · draft for public comment";
                  font-family:"IBM Plex Mono",monospace; font-size:7.5pt;
                  letter-spacing:.06em; color:#B0AB99; }
  @bottom-right { content: counter(page); font-family:"IBM Plex Mono",monospace;
                  font-size:8pt; font-weight:600; color:#5C5850; }
  @top-right    { content: string(section); font-family:"Chakra Petch",sans-serif;
                  font-size:7.5pt; letter-spacing:.13em; text-transform:uppercase;
                  color:#B0AB99; }
}
@page cover { margin:0;
  @bottom-left{content:none} @bottom-center{content:none}
  @bottom-right{content:none} @top-right{content:none} }
.cover { page:cover; }

:root { --ink:#221F18; --soft:#5C5850; --faint:#8C8878; --line:#E6E2D7;
        --rule:#CFCBBE; --accent:#4F6B00; --wash:#F7F5EE; }

* { box-sizing:border-box; }
/* hyphens:manual, not auto. A hyphenated final line is what the fragmenter
   mismeasured at the page 7 → 8 break: it wrote a break token into the middle of
   "threshold", and the line it thought it had placed was actually sitting in the
   off-sheet overflow column, so 92 characters were laid out and never painted.
   Automatic hyphenation also corrupted the text layer wherever it fired at a
   break — "mishandles instruct-" / "-ions" extracts with the running footer
   wedged inside the word, so copy-paste out of the PDF produced garbage. Turning
   it off costs a little evenness in the justified rag and removes both; the
   measure is ~85 characters, wide enough not to need it.

   This only changes where the lines fall. It does not fix the fragmenter, so it
   would not stop the same bug reappearing after an edit to the prose — the guard
   in bin/print-page.mjs is what makes that loud instead of silent. */
body { font-family:"IBM Plex Serif",Georgia,serif; font-size:10pt;
  line-height:1.62; color:var(--ink); margin:0;
  font-variant-numeric:oldstyle-num proportional-nums;
  hyphens:manual; -webkit-hyphens:manual; text-align:justify;
  hanging-punctuation:first last; }

/* ── cover ─────────────────────────────────────────────────────────────── */
.cover { height:100%; padding:34mm 30mm 24mm; position:relative;
  text-align:left; }
.cover::before, .cover::after { content:""; position:absolute; left:14mm;
  right:14mm; height:0; border-top:.4pt solid var(--rule); }
.cover::before { top:16mm; } .cover::after { bottom:16mm; }
.cover .mark { margin:0 0 42mm; font-family:"Chakra Petch",sans-serif; font-weight:600;
  font-size:8.5pt; letter-spacing:.18em; text-transform:uppercase;
  color:var(--accent); }
.covertitle { font-family:"Figtree",sans-serif; font-weight:600; font-size:31pt;
  line-height:1.14; letter-spacing:-0.02em; margin:0 0 9mm; max-width:15em;
  text-align:left; hyphens:none; }
.cover .tenets { display:flex; gap:0; margin:0 0 10mm; padding:0; list-style:none;
  border-top:.4pt solid var(--rule); border-bottom:.4pt solid var(--rule); }
.cover .tenets li { flex:1; font-family:"Figtree",sans-serif; font-size:8.5pt;
  color:var(--soft); padding:3.5mm 0 3.5mm 4mm; position:relative; hyphens:none; }
.cover .tenets li + li { border-left:.4pt solid var(--line); }
.cover .tenets li::before { content:""; position:absolute; left:0; top:4.4mm;
  width:1.4mm; height:1.4mm; background:var(--accent); }
.cover .meta { font-family:"IBM Plex Mono",monospace; font-size:8pt;
  line-height:1.85; color:var(--soft); text-align:left; }
.cover .meta b { font-weight:600; color:var(--ink); }
.cover .by { font-family:"IBM Plex Serif",serif; font-size:9pt; color:var(--soft);
  margin:0 0 6mm; max-width:34em; text-align:left; hyphens:none; }
.cover .by { line-height:1.85; }
.cover .by sup { font-family:"Chakra Petch",sans-serif; font-size:6pt;
  letter-spacing:.08em; color:var(--faint); vertical-align:.42em;
  margin-left:.5pt; }

/* ── contents ──────────────────────────────────────────────────────────── */
.toc { break-before:page; }
.toc h2 { font-family:"Chakra Petch",sans-serif; font-weight:600; font-size:9pt;
  letter-spacing:.16em; text-transform:uppercase; color:var(--soft);
  margin:0 0 6mm; padding-bottom:2.5mm; border-bottom:.5pt solid var(--rule); }
.toc ol { list-style:none; margin:0; padding:0; }
.toc li { margin:0; }
.toc a { text-decoration:none; color:var(--ink); display:flex;
  align-items:baseline; gap:0; }
.toc .t { order:1; }
/* the leader: a dotted rule that grows to fill, so the number always lands
   on the right margin however long the title is */
.toc a::before { content:""; order:2; flex:1 1 auto; margin:0 3pt;
  border-bottom:.4pt dotted var(--rule); transform:translateY(-2px); }
.toc a::after { content:target-counter(attr(href), page); order:3;
  font-family:"IBM Plex Mono",monospace; font-size:8.5pt; color:var(--soft);
  font-variant-numeric:tabular-nums; }
.toc li.l1 > a { font-family:"Figtree",sans-serif; font-weight:500; font-size:10.5pt;
  padding:2.6mm 0 1mm; }
.toc li.l1 + li.l1 > a { border-top:.4pt solid var(--line); }
.toc li.l2 > a { font-size:9.5pt; color:var(--soft); padding:.7mm 0 .7mm 7mm; }
.toc li.l2 > a::after { color:var(--faint); }

/* ── running text ──────────────────────────────────────────────────────── */
h1:not(.covertitle) { font-family:"Figtree",sans-serif; font-weight:600; font-size:19pt;
  line-height:1.2; letter-spacing:-0.016em; color:var(--ink);
  margin:0 0 5mm; padding-bottom:3mm; border-bottom:.5pt solid var(--rule);
  break-before:page; break-after:avoid;
  text-align:left; hyphens:none; text-wrap:balance; }
h1:not(.covertitle) { string-set:section content(text); }
h2 { font-family:"Figtree",sans-serif; font-weight:600; font-size:13.5pt;
  line-height:1.25; letter-spacing:-0.01em; margin:9mm 0 2.5mm;
  break-after:avoid; text-align:left; hyphens:none; }
h3 { font-family:"Chakra Petch",sans-serif; font-weight:600; font-size:8.5pt;
  letter-spacing:.13em; text-transform:uppercase; color:var(--accent);
  margin:6mm 0 1.8mm; break-after:avoid; text-align:left; hyphens:none; }
h4 { font-family:"IBM Plex Mono",monospace; font-size:8.5pt; font-weight:600;
  letter-spacing:.03em; color:var(--soft); margin:4mm 0 1.5mm;
  break-after:avoid; text-align:left; }
p { margin:0 0 2.6mm; orphans:3; widows:3; }
/* The fragmenter lays a paragraph out more than once as it decides where the
   page ends, and during that pass the closing line is treated as though more
   text followed — so it came out stretched across the full measure. Stating
   the last line's alignment outright rather than leaving it to `auto` costs
   nothing and settles it. */
p, li, dd, .creq, .famreq { text-align-last:left; }
h1 + p, h2 + p, h3 + p { text-indent:0; }
strong, b { font-weight:600; }
em, i { font-style:italic; }
a { color:var(--ink); text-decoration:none;
  border-bottom:.4pt solid var(--rule); }
code { font-family:"IBM Plex Mono",monospace; font-size:8.5pt;
  background:var(--wash); padding:.3mm 1mm; }
ul, ol { margin:0 0 3mm; padding-left:5.5mm; }
li { margin:0 0 1.2mm; }
blockquote { border-left:1.2pt solid var(--accent); margin:4mm 0;
  padding:0 0 0 5mm; color:var(--soft); font-style:italic; }

/* The figures are vector now, exported from the design file, so they can fill
   the measure without losing anything — the raster versions were capped at
   118mm because filling the column printed them near 110dpi. */
figure { break-inside:avoid; margin:6mm 0; text-align:center; }
img { display:block; max-width:100%; height:auto; margin:0 auto; }
/* pandoc turns `![alt](src)` into a figure with a caption, which is what we
   want in print: the alt text was empty on every one of these, so the figures
   were unlabelled in the document and invisible to a screen reader. Set as a
   caption rather than as body prose, and numbered, so a figure can be cited. */
figcaption { counter-increment:fig; font-family:"Figtree",sans-serif;
  font-size:8.5pt; line-height:1.45; color:var(--soft); margin:3mm auto 0;
  max-width:118mm; text-align:left; hyphens:none; }
figcaption::before { content:"Figure " counter(fig) "  "; font-family:"IBM Plex Mono",monospace;
  font-size:7.5pt; font-weight:600; color:var(--accent); letter-spacing:.04em; }
body { counter-reset:fig; }

table { border-collapse:collapse; width:100%; font-size:8.5pt; margin:4mm 0;
  break-inside:avoid; text-align:left; hyphens:none; }
th, td { border-bottom:.4pt solid var(--line); padding:2mm 3mm 2mm 0;
  text-align:left; vertical-align:top; }
th { font-family:"Chakra Petch",sans-serif; font-size:7pt; font-weight:600;
  text-transform:uppercase; letter-spacing:.1em; color:var(--faint);
  border-bottom:.5pt solid var(--rule); }

/* ── appendix ──────────────────────────────────────────────────────────── */
.appendix { break-before:page; }
.fam { break-before:auto; margin:0 0 7mm; }
.fam h2 { font-weight:600; display:flex; align-items:baseline; gap:4mm; margin:7mm 0 1mm;
  padding-bottom:2mm; border-bottom:.5pt solid var(--rule); break-after:avoid; }
.fam .span { margin-left:auto; font-family:"IBM Plex Mono",monospace;
  font-size:8pt; font-weight:600; color:var(--accent); letter-spacing:.02em; }
/* An outcome heading, its requirement line and its first control are one unit.
   .fam h2 already declined to be the last thing on a page, but break-after:avoid
   binds a heading only to the element immediately following it — the requirement
   paragraph was then free to break away and take the first control with it,
   leaving "Constrain" and "Respond" stranded on their rules at the foot of a page
   under an inch and a half of white. Carrying the avoid along the chain keeps the
   group together. */
.famreq { font-family:"Figtree",sans-serif; font-size:9pt; color:var(--soft);
  margin:0 0 4mm; hyphens:none; text-align:left;
  break-before:avoid; break-after:avoid; }
.famreq + .ctl { break-before:avoid; }
/* One control, one block: identifier in the margin, everything else in the
   measure. break-inside:avoid is the whole point — a control that splits
   across a page leaves its description with no identifier attached. */
.ctl { display:grid; grid-template-columns:19mm 1fr; gap:0 4mm;
  padding:2.6mm 0; border-top:.4pt solid var(--line); break-inside:avoid; }
.ctl .cid { font-family:"IBM Plex Mono",monospace; font-size:8.5pt;
  font-weight:600; color:var(--accent); letter-spacing:.01em; padding-top:.4mm; }
.ctl .chead { display:flex; align-items:baseline; gap:4mm; margin:0 0 1mm; }
.ctl .ctitle { font-family:"Figtree",sans-serif; font-weight:500; font-size:10pt;
  color:var(--ink); hyphens:none; }
.ctl .ctype { margin-left:auto; font-family:"Chakra Petch",sans-serif;
  font-weight:500; font-size:6.8pt; letter-spacing:.13em;
  text-transform:uppercase; color:var(--faint); white-space:nowrap; }
.ctl .creq { margin:0; font-size:9pt; line-height:1.55; color:var(--soft); }
"""


PUBLISHED_RE = r"Published as\b[^\n]*?·\s*(\d{1,2}\s+[A-Za-z]+\s+\d{4})"
COMMENTS_RE = r"Draft for public comment until\s+(\d{1,2}\s+[A-Za-z]+\s+\d{4})"


def front_matter_dates():
    """The paper's published date and comment deadline, from its own front matter.

    One reading, used for both the cover and the PDF's timestamps. The cover used
    to carry its own hardcoded copy of both dates while only the timestamps were
    parsed from here, so moving the paper's date produced a PDF whose Document
    Properties said 14 August and whose cover, printed by this same function, said
    30 July. Nothing compared them because nothing could: they were two constants
    that happened to agree. Derived from one string they cannot disagree, which is
    a stronger guarantee than a check that they do.

    hugo.toml states both dates a third time, for the site. That copy cannot be
    removed — the templates need it and the paper is not a Hugo page — so
    check-copy compares it against this front matter instead.

    Reading the date from the source rather than the clock is also what makes the
    build reproducible: SOURCE_DATE_EPOCH derives from it, so the same source
    always yields the same bytes.

    This raises rather than falling back. The previous version stamped 1 January
    2026 and warned, on the reasoning that a wrong date still builds reproducibly
    and breaking a build over metadata is worse. That reasoning held while the
    date was only in the Document Properties. It does not hold now the cover is
    printed from the same value: a conference handout whose cover reads "published
    1 January 2026" is worse than a build that stops and says which line it could
    not read. Abbreviating the month is enough to land here.
    """
    text = SRC.read_text(encoding="utf-8")
    found = {}
    for key, pattern, shape in (
        ("published", PUBLISHED_RE, "Published as **Agent Baseline** · v… · 30 July 2026 · …"),
        ("comments", COMMENTS_RE, "Draft for public comment until 30 September 2026."),
    ):
        m = re.search(pattern, text)
        if not m:
            sys.exit(f"cannot read the {key} date from whitepaper.md's front matter.\n"
                     f"  expected a line shaped like: {shape}\n"
                     f"The cover and the PDF's timestamps are both printed from that line, "
                     f"so there is nothing sensible to fall back to. Fix the front matter, "
                     f"or update {pathlib.Path(__file__).name} if the wording moved on purpose.")
        try:
            datetime.datetime.strptime(m.group(1), "%d %B %Y")
        except ValueError:
            sys.exit(f"whitepaper.md's {key} date is not a date this can parse: "
                     f"{m.group(1)!r} — write it as '30 July 2026', month unabbreviated.")
        found[key] = m.group(1)
    return found


def published_epoch(published):
    """The published date as a UTC epoch, for /CreationDate and /ModDate."""
    d = datetime.datetime.strptime(published, "%d %B %Y")
    # Midday rather than midnight: the stored value is UTC but readers see it in
    # local time, and a midnight stamp displays as the previous day anywhere west
    # of Greenwich — a PDF of the 30th reporting the 29th looks like a bug in the
    # date. Noon survives every offset.
    return calendar.timegm(d.timetuple()) + 12 * 3600


def render(out, provenance):
    dates = front_matter_dates()
    version = "1.0-draft"
    m = re.search(r'^version:\s*"([^"]+)"',
                  (ROOT / "whitepaper" / "controls.yaml").read_text(encoding="utf-8"), re.M)
    if m:
        version = m.group(1)
    # str.replace, not %-formatting: the stylesheet is full of
    # percentages and every one of them is a format specifier.
    css = CSS.replace("@VERSION@", version)

    authors = ""
    cpath = ROOT / "whitepaper" / "contributors.yaml"
    if cpath.exists():
        people = []
        for blk in re.split(r"\n(?=  - )", record(cpath).read_text(encoding="utf-8")):
            if not blk.lstrip().startswith("- name:"):
                continue
            def f(k):
                m = re.search(rf"^[ \t-]*{k}:[ \t]*(.+)$", blk, re.M)
                return m.group(1).strip().strip('"') if m else ""
            # confirmed: false means the affiliation has not been agreed by the
            # person. contributors.yaml is explicit that those must not be
            # published, and a cover is the most published place there is.
            if f("confirmed").lower() == "true" and f("name"):
                people.append((f("sortkey") or f("name"), f("name"), f("affiliation")))
        people.sort()
        if people:
            names = [f'{n}<sup>{a}</sup>' if a else n for _, n, a in people]
            joined = (", ".join(names[:-1]) + " and " + names[-1]
                      if len(names) > 1 else names[0])
            authors = "Drafted by " + joined + "."

    doc = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>Agent Baseline — six security outcomes for enterprise AI agents</title>
<style>{FONTS}</style>
<style>{css}</style>
</head><body>

<section class="cover">
  <p class="mark">Agent Baseline · agentbaseline.org</p>
  <h1 class="covertitle">Six security outcomes for safely building, deploying and operating AI agents</h1>
  <ul class="tenets">
    <li>Identify the agent.</li><li>Bound its authority.</li>
    <li>Control its actions.</li><li>Prove its outcomes.</li>
  </ul>
  <p class="by">{authors}</p>
  <p class="meta">
    <b>v{version}</b> · published {dates["published"]}<br>
    Draft for public comment until {dates["comments"]}<br>
    {len(CONTROLS)} controls across {len(OUTCOMES)} outcomes<br>
    Prose and figures CC BY 4.0 · schemas Apache-2.0
  </p>
</section>

<nav class="toc"><h2>Contents</h2><ol>{toc_html}</ol></nav>

{body}

<section class="appendix">
  <h1 id="appendix-a">Appendix A. Canonical capability map</h1>
  <p>This catalogue is generated from <code>whitepaper/controls.yaml</code>, which is
  the source of truth for the baseline. Capabilities are grouped by their primary
  required outcome.</p>
  {appendix_html}
</section>

<script>window.PagedConfig = {{ auto: false }};</script>
<script src="{PAGED.as_uri()}"></script>
</body></html>"""

    page = WORK / "paper.html"
    page.write_text(doc, encoding="utf-8")

    # Everything the document pulls in from disk at print time. The figures are
    # rewritten to absolute file URLs above and Paged.js is loaded from one, so
    # sweeping the rendered document finds them without a second list to keep in
    # step — including the ones a future template adds. Anything outside the repo
    # is somebody's local path and cannot be a recorded input.
    for url in set(re.findall(r'file://[^"\'\s>)]+', doc)):
        p = pathlib.Path(urllib.request.url2pathname(url[len("file://"):]))
        if p.exists() and ROOT in p.resolve().parents:
            record(p)
    # The scripts are inputs too: the stylesheet and the cover live in this file,
    # the normalisation lives in print-page.mjs, and the catalogue reader in
    # controls_source.py decides what the appendix says. A change to any of them
    # changes the artifact, so a manifest that omitted them would call a stale PDF
    # current.
    for script in (pathlib.Path(__file__), ROOT / "bin" / "print-page.mjs",
                   ROOT / "bin" / "controls_source.py"):
        record(script)

    out.parent.mkdir(parents=True, exist_ok=True)
    # Rendered to a sibling and moved into place, never written through. The old
    # version unlinked the destination and then spent several seconds in Chrome;
    # anything that killed the process in that window — Ctrl-C, a CI timeout, the
    # OOM killer — left the tree with no whitepaper.pdf at all, and the only copy
    # of it in a temporary directory that died with the process. os.replace is
    # atomic within a filesystem, and the temporary file is a sibling so that it
    # is the same filesystem.
    tmp = out.with_name(f".{out.name}.new-{os.getpid()}")
    # A kill that skips the cleanup below leaves one of these; sweep them rather
    # than accumulating megabyte files in static/ until someone notices. The pid
    # in the name is what makes that safe: a leftover whose process is still alive
    # is a build in flight, and deleting it would be this script causing the exact
    # failure it is here to prevent.
    for stale in out.parent.glob(f".{out.name}.new-*"):
        try:
            pid = int(stale.name.rsplit("-", 1)[-1])
        except ValueError:
            continue
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            stale.unlink(missing_ok=True)
        except PermissionError:
            pass  # alive, and not ours
    # The PDF is committed, so it must be reproducible: two builds of unchanged
    # source have to produce the same bytes, or `git diff` reports the artifact as
    # modified on every rebuild and a reviewer cannot tell a rebuild from an edit.
    # Chrome stamps the wall clock into /CreationDate and /ModDate; print-page.mjs
    # rewrites them from SOURCE_DATE_EPOCH, which is set here from the paper's own
    # published date. The document's date is the honest thing for it to carry, and
    # it only moves when the paper does. An epoch already in the environment wins,
    # so a release process can pin it.
    env = dict(os.environ)
    env.setdefault("SOURCE_DATE_EPOCH", str(published_epoch(dates["published"])))
    try:
        r = subprocess.run(["node", str(ROOT / "bin" / "print-page.mjs"),
                            str(page), str(tmp)], capture_output=True, text=True, env=env)
        if r.returncode or not tmp.exists():
            sys.exit(f"PDF FAILED\n{r.stdout}\n{r.stderr}")
        print(f"  {r.stdout.strip()}")
        blob = tmp.read_bytes()
        os.replace(tmp, out)
    finally:
        tmp.unlink(missing_ok=True)

    pages = len(re.findall(rb"/Type\s*/Page[^s]", blob))
    print(f"wrote {rel(out)}  {len(blob):,} bytes · {pages} pages "
          f"· {len(CONTROLS)} controls · {len(toc)} contents entries")

    if provenance:
        write_provenance(provenance, out, blob, pages, env["SOURCE_DATE_EPOCH"])
        print(f"wrote {rel(provenance)}  {len(INPUTS)} recorded input(s)")


def pdf_string(blob, key):
    """One of the PDF's own document-information strings, unescaped."""
    m = re.search(rb"/" + key.encode() + rb"\s*\((.*?)(?<!\\)\)", blob, re.S)
    return re.sub(r"\\([()\\])", r"\1", m.group(1).decode("latin1")) if m else ""


def write_provenance(path, out, blob, pages, epoch):
    """Record what was built, from what, by what.

    The toolchain fields are read back out of the PDF rather than asked of the
    machine: /Producer and /Creator are the artifact's own statement about the
    browser and platform that made it, which is the thing a later reader needs and
    the thing that cannot be got wrong by querying the wrong binary. They are also
    what makes a failure legible — an artifact built by Skia/PDF m150 on macOS is
    not going to come out byte-identical under a different browser or a different
    kernel, and a check that knows both strings can say so instead of blaming the
    paper.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    doc = {
        "artifact": rel(out),
        "bytes": len(blob),
        "pages": pages,
        "sha256": hashlib.sha256(blob).hexdigest(),
        "source_date_epoch": epoch,
        "built_by": {"producer": pdf_string(blob, "Producer"),
                     "creator": pdf_string(blob, "Creator")},
        "inputs": dict(sorted(INPUTS.items())),
    }
    path.write_text(json.dumps(doc, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    # --out exists so that a caller wanting to inspect a build never has to point
    # the renderer at the tracked file. check-pdf-reproducible used to rebuild over
    # static/whitepaper.pdf and copy the committed bytes back afterwards, which
    # made merely running the check a way to lose the deliverable. It now builds
    # somewhere else entirely, so there is no window to lose it in.
    ap.add_argument("--out", type=pathlib.Path, default=OUT,
                    help="where to write the PDF (default: static/whitepaper.pdf)")
    ap.add_argument("--provenance", type=pathlib.Path, default=None,
                    help="where to write the build manifest "
                         "(default: whitepaper/pdf.provenance.json, and only when "
                         "--out is the tracked artifact)")
    args = ap.parse_args()
    prov = args.provenance
    if prov is None and args.out.resolve() == OUT.resolve():
        prov = PROVENANCE
    render(args.out, prov)
