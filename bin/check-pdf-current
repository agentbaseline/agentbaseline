#!/usr/bin/env python3
"""Prove the committed static/whitepaper.pdf is the one this source builds.

This is the enforceable half of the reproducibility question, and it is the half
that matters on a pull request. The other half — do two builds of unchanged source
produce the same bytes — is bin/check-pdf-reproducible, which has to run the
browser and so can only run where that browser is. This one runs anywhere Python
runs: no Chrome, no pandoc, no node, about a tenth of a second. That is the whole
point of it. A gate nothing invokes is a note to self, and check-pdf-reproducible
was invoked by nothing at all — not CI, not a hook, not another script — because
it could not be: ubuntu-latest has neither pandoc nor a Chrome, and the committed
bytes carry the exact browser build and platform that produced them, so a rebuild
on a runner would differ from the committed file for reasons that have nothing to
do with the paper.

So the two questions are separated and each is asked where it can be answered:

  * did the artifact keep up with its source — here, on every pull request;
  * is the build deterministic — in bin/check-pdf-reproducible, on the toolchain
    that built it, and in the `determinism` CI job, which builds twice on a pinned
    browser and compares those two builds to each other.

The evidence is whitepaper/pdf.provenance.json, which bin/build-pdf writes as it
renders: the digest of every file the render actually read, the digest of the PDF
it produced, and the browser that produced it. Recorded by the build rather than
listed by hand, so adding a figure adds it to the manifest without anyone
remembering to.

What this does NOT prove, because it is worth being exact about a gate that runs
on every commit:

  * that the PDF renders correctly — check-appendix, check-figure and the
    off-sheet guard in bin/print-page.mjs are the ones that read the content;
  * that the manifest describes a build anyone can reproduce. It records the
    browser; it does not re-run it. Only check-pdf-reproducible does that.

It does prove that whitepaper.md, controls.yaml, contributors.yaml, the figures,
the fonts and the three scripts that turn them into a PDF are all at the versions
the committed PDF was made from — which is exactly "nobody edited the paper and
forgot to rebuild", and "nobody hand-patched the PDF".
"""
import hashlib, json, pathlib, re, sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
PROVENANCE = ROOT / "whitepaper" / "pdf.provenance.json"

REBUILD = ("Run `python3 bin/build-pdf` and commit static/whitepaper.pdf together "
           "with whitepaper/pdf.provenance.json.")

if not PROVENANCE.exists():
    sys.exit(f"{PROVENANCE.relative_to(ROOT)} is missing, so there is nothing to "
             f"check the artifact against. {REBUILD}")

try:
    manifest = json.loads(PROVENANCE.read_text(encoding="utf-8"))
except json.JSONDecodeError as e:
    sys.exit(f"{PROVENANCE.relative_to(ROOT)} is not readable JSON: {e}")

PDF = ROOT / manifest["artifact"]
if not PDF.exists():
    sys.exit(f"{manifest['artifact']} is missing — the manifest describes an "
             f"artifact that is not in the tree. {REBUILD}")


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def pdf_string(blob, key):
    m = re.search(rb"/" + key.encode() + rb"\s*\((.*?)(?<!\\)\)", blob, re.S)
    return re.sub(r"\\([()\\])", r"\1", m.group(1).decode("latin1")) if m else ""


problems = []

# ── 1 · every recorded input is still at the version that was rendered ────────
# Reported as a list rather than on the first mismatch: "whitepaper.md and two
# figures moved" is a different situation from "a font was replaced", and seeing
# only the first of them sends the reader looking in one place for one of several
# reasons the artifact is behind.
moved, gone = [], []
for rel, digest in manifest.get("inputs", {}).items():
    p = ROOT / rel
    if not p.exists():
        gone.append(rel)
    elif sha(p) != digest:
        moved.append(rel)

if gone:
    problems.append("These inputs are recorded in the manifest but no longer exist:\n" +
                    "".join(f"    {r}\n" for r in gone) +
                    "  Either they were deleted and the PDF still contains them, or the "
                    "manifest is from a different tree.")
if moved:
    problems.append("These inputs have changed since the committed PDF was built:\n" +
                    "".join(f"    {r}\n" for r in moved) +
                    f"  The PDF in the tree is stale. {REBUILD}\n"
                    "  Note that the paper's `# Contents` and `# Appendix A` are "
                    "regenerated by the build, so an edit confined to those will "
                    "produce an identical PDF and a new manifest. Commit both.")

# ── 2 · the artifact itself is the one the manifest describes ────────────────
blob = PDF.read_bytes()
if len(blob) != manifest["bytes"] or sha(PDF) != manifest["sha256"]:
    detail = (f"{len(blob):,} bytes, sha256 {sha(PDF)[:16]}…\n"
              f"    manifest says {manifest['bytes']:,} bytes, "
              f"sha256 {manifest['sha256'][:16]}…")
    if moved or gone:
        problems.append(f"{manifest['artifact']} also does not match the manifest:\n"
                        f"    {detail}")
    else:
        # Nothing the build reads has moved, so a changed artifact was not produced
        # by this source. Something wrote to the PDF directly.
        problems.append(
            f"{manifest['artifact']} does not match the manifest, but every input "
            f"the build reads is unchanged:\n    {detail}\n"
            f"  The PDF was modified without the source moving — a hand-patch, a "
            f"partial checkout, a merge that took the artifact from one side and the "
            f"manifest from the other, or a build on a different browser. Compare "
            f"`built_by` in the manifest with what your Chrome reports. {REBUILD}")

# ── 3 · the manifest is describing this PDF, not a previous one ──────────────
# The digests above would already catch a mismatched pair. This reads the two
# toolchain strings back out of the artifact so that when they disagree the
# message can say which browser, rather than leaving a reviewer to diff a
# megabyte of binary to find out.
for key in ("producer", "creator"):
    want = manifest.get("built_by", {}).get(key, "")
    got = pdf_string(blob, key.capitalize())
    if want and got and want != got:
        problems.append(f"the artifact's /{key.capitalize()} is not the one recorded:\n"
                        f"    manifest: {want}\n"
                        f"    artifact: {got}\n"
                        f"  The committed PDF and the committed manifest came from "
                        f"different builds. {REBUILD}")

if problems:
    print(f"pdf: NOT current — {len(problems)} problem(s)\n", file=sys.stderr)
    for p in problems:
        print(f"  {p}\n", file=sys.stderr)
    sys.exit(1)

print(f"pdf: current · {manifest['artifact']} · {manifest['bytes']:,} bytes · "
      f"{manifest['pages']} pages · {len(manifest.get('inputs', {}))} inputs verified")
print(f"     built by {manifest['built_by']['producer']}")
