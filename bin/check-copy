#!/usr/bin/env python3
"""
Find repeated phrasing across everything a reader sees.

Written because the same sentence shipped twice on one page, a caption described
a rejected variant, and a citation quoted a title that no longer existed. All
three were prose referring to prose, which nothing checked.

Reports:
  1. sentences that appear more than once across the corpus
  2. long phrases repeated in different places
  3. quoted titles that match no title in the corpus
  4. the tic list — phrases this project overuses

Advisory by default; --strict makes repeats an error.
"""
import re, sys, pathlib, collections, difflib, html

ROOT = pathlib.Path(__file__).resolve().parents[1]
STRICT = "--strict" in sys.argv

SOURCES = [
    ROOT / "public" / "index.html",
    ROOT / "public" / "controls" / "index.html",
    ROOT / "README.md", ROOT / "VERSIONING.md", ROOT / "GOVERNANCE.md",
    ROOT / "PROVENANCE.md", ROOT / "CONTRIBUTING.md",
]

def prose(path):
    t = path.read_text(encoding="utf-8")
    if path.suffix == ".html":
        t = re.sub(r"<(script|style|svg)[^>]*>.*?</\1>", " ", t, flags=re.S)
        t = re.sub(r"<[^>]+>", " ", t)
        t = html.unescape(t)
    else:
        t = re.sub(r"```.*?```", " ", t, flags=re.S)
        t = re.sub(r"^\s*[|#>\-*].*$", " ", t, flags=re.M)   # tables, headings, lists
        t = re.sub(r"[*`_\[\]()]", " ", t)
    return " ".join(t.split())

def sentences(t):
    """Sentences, plus short runs of them glued together.

    A four-sentence refrain of three words each slipped through a five-word
    minimum entirely — every part was too short to compare, and the whole was
    never assembled. Short sentences are now also emitted in runs of three.
    """
    parts = [s.strip() for s in re.split(r"(?<=[.?!])\s+", t) if s.strip()]
    for s in parts:
        if 5 <= len(s.split()) and len(s) < 400:
            yield s
    short = [(i, s) for i, s in enumerate(parts) if len(s.split()) < 5]
    for j in range(len(short) - 2):
        (i0, a), (i1, b), (i2, cc) = short[j:j + 3]
        if i1 == i0 + 1 and i2 == i1 + 1:
            yield f"{a} {b} {cc}"

corpus = {}
for p in SOURCES:
    if p.exists():
        corpus[p.relative_to(ROOT).as_posix()] = prose(p)

# ── 0 · the built output must come from this configuration ───────────────────
# Every check below that reads public/ is only as good as the build that made
# it. A `hugo server` left running rewrites public/ continuously with a
# localhost baseURL, so a check can validate a build nobody deployed and pass.
# That cost three false alarms in one evening: a reorder that had worked was
# reported as broken, twice.
def _built_matches_config():
    cfg = (ROOT / "hugo.toml").read_text(encoding="utf-8")
    m = re.search(r'^baseURL\s*=\s*"([^"]+)"', cfg, re.M)
    built = ROOT / "public" / "index.html"
    if not m or not built.exists():
        return None
    want = m.group(1).rstrip("/")
    h = built.read_text(encoding="utf-8")
    got = re.search(r'canonical["\']?\s+href=["\']?([^"\'>\s]+)', h)
    if got and not got.group(1).startswith(want):
        return (want, got.group(1))
    return None

_drift = _built_matches_config()
if _drift:
    sys.exit(f"public/ was built with a different baseURL than hugo.toml sets.\n"
             f"  hugo.toml : {_drift[0]}\n"
             f"  public/   : {_drift[1]}\n"
             f"Usually a `hugo server` is still running and rewriting public/.\n"
             f"  pkill -f 'hugo server' && hugo --gc --minify\n"
             f"Refusing to check a build that is not the one you would deploy.")

findings = []

# ── 1 · the same sentence twice ───────────────────────────────────────────────
seen = collections.defaultdict(list)
for name, text in corpus.items():
    for s in sentences(text):
        seen[s.lower().rstrip(".")].append(name)
# Chrome shared by both pages — the masthead, the event strip — renders the same
# sentence twice from one partial. That is one thing shown twice, not prose
# written twice, which is the same reasoning the near-duplicate check already
# uses for the roster. Narrow on purpose: it only forgives a sentence appearing
# in exactly those two files and nowhere else.
_CHROME = {"public/index.html", "public/controls/index.html"}
for s, where in seen.items():
    if set(where) == _CHROME and len(set(where)) == len(where):
        continue
    if len(where) > 1:
        findings.append(("repeat", f"“{s[:78]}…” appears in {', '.join(sorted(set(where)))}"
                                   if len(s) > 78 else
                                   f"“{s}” appears in {', '.join(sorted(set(where)))}"))

# ── 2 · near-duplicate sentences, which is how the split went wrong ───────────
allsent = [(n, s) for n, t in corpus.items() for s in sentences(t)]
for i, (n1, s1) in enumerate(allsent):
    for n2, s2 in allsent[i + 1:]:
        if s1.lower() == s2.lower():
            continue
        if abs(len(s1) - len(s2)) > max(len(s1), len(s2)) * 0.6:
            continue
        # the roster and /controls/ render the same outcome from one source —
        # that is one fact shown twice, not prose written twice
        if {n1, n2} == {"public/index.html", "public/controls/index.html"}:
            continue
        r = difflib.SequenceMatcher(None, s1.lower(), s2.lower()).ratio()
        if r > 0.72:
            findings.append(("near", f"{r:.0%} alike — {n1}: “{s1[:58]}…” / "
                                     f"{n2}: “{s2[:58]}…”"))

# ── 3 · a quoted title must be a title that exists ───────────────────────────
titles = set()
for p in [ROOT / "whitepaper" / "whitepaper.md", ROOT / "README.md"]:
    if p.exists():
        m = re.search(r"^#\s+(.+)$", p.read_text(encoding="utf-8"), re.M)
        if m: titles.add(m.group(1).strip().lower())
idx = ROOT / "public" / "index.html"
if idx.exists():
    h = re.sub(r"<style[^>]*>.*?</style>", " ", idx.read_text(encoding="utf-8"), flags=re.S)
    m = re.search(r"<h1>(.*?)</h1>", h, re.S)
    if m: titles.add(re.sub(r"<[^>]+>", "", m.group(1)).strip().lower())
    for q in re.findall(r"[“\"]([^”\"]{12,90})[”\"]", html.unescape(re.sub(r"<[^>]+>", " ", h))):
        if q.lower().strip() not in titles and q[0].isupper():
            findings.append(("title", f"quoted “{q}” matches no title in the corpus"))

# ── 3b · the page may not assert what the controls prohibit ──────────────────
# The page said "it holds credentials" while AUT-04 requires that credentials
# "shall not be stored in model context, memory or agent-accessible files".
# Describing the prohibited state as though it were the design is the worst kind
# of copy error here, because it reads as authoritative.
CONTRADICTIONS = [
    (r"\b(?:holds?|stores?|retains?|keeps?) (?:the )?credentials\b",
     "AUT-04 requires credentials not be stored by the agent"),
    # negated forms are the page denying these, which is the point — only an
    # unnegated assertion is a contradiction
    (r"(?<!no )(?<!not )\bconform(?:ing|ance) (?:control plane|programme)\b",
     "the page states no conformance programme exists"),
    (r"(?<!not a )\bminimum standard\b",
     "the page states this is not a standard"),
]
for name, text in corpus.items():
    for pat, why in CONTRADICTIONS:
        for m in re.finditer(pat, text, re.I):
            findings.append(("contra", f"{name}: “{m.group(0)}” — {why}"))

# ── 3c · README ranges must track controls.yaml ──────────────────────────────
_y = (ROOT / "whitepaper" / "controls.yaml")
_r = (ROOT / "README.md")
if _y.exists() and _r.exists():
    _hi = {}
    for _m in re.finditer(r"^  - id: (\w+)-(\d+)$", _y.read_text(encoding="utf-8"), re.M):
        _f, _n = _m.group(1), int(_m.group(2))
        _hi[_f] = max(_hi.get(_f, 0), _n)
    _rt = _r.read_text(encoding="utf-8")
    for _f, _n in sorted(_hi.items()):
        if f"`{_f}-01`–`{_f}-{_n:02d}`" not in _rt:
            findings.append(("contra", f"README: {_f} range is stale — controls.yaml has "
                                       f"{_f}-{_n:02d} as the highest identifier"))

# ── 3c-bis · the paper has one published date, not three ─────────────────────
# The date lived in three independent places: the paper's own front matter, a
# hardcoded string on the PDF cover, and hugo.toml for the site. Nothing compared
# any of them, so moving one moved one — a PDF whose Document Properties said 14
# August and whose cover, printed by the same script in the same run, said 30
# July. bin/build-pdf now prints the cover from the front matter, so those two
# cannot disagree; hugo.toml cannot be folded in the same way, because the
# templates need a param and the paper is not a Hugo page. So it is compared here.
#
# A publication date is the one field a citation carries, which is why it is worth
# a check of its own rather than a note in a contributing guide.
_wp = ROOT / "whitepaper" / "whitepaper.md"
_cfg = ROOT / "hugo.toml"
if _wp.exists() and _cfg.exists():
    _w, _c = _wp.read_text(encoding="utf-8"), _cfg.read_text(encoding="utf-8")
    for _label, _paper_re, _param in (
        ("published date",
         r"Published as\b[^\n]*?·\s*(\d{1,2}\s+[A-Za-z]+\s+\d{4})", "published"),
        ("comment deadline",
         r"Draft for public comment until\s+(\d{1,2}\s+[A-Za-z]+\s+\d{4})", "commentsUntil"),
        ("version",
         r"Published as\b[^\n]*?·\s*v([0-9][^\s·]*)", "version"),
    ):
        _pm = re.search(_paper_re, _w)
        _cm = re.search(rf'^\s*{_param}\s*=\s*"([^"]+)"', _c, re.M)
        if not _pm:
            findings.append(("contra", f"whitepaper.md: cannot find the {_label} in the "
                                       f"front matter — bin/build-pdf prints the cover "
                                       f"from that line and will refuse to build"))
        elif not _cm:
            findings.append(("contra", f"hugo.toml: no `{_param}` param, so the site "
                                       f"cannot state the {_label} the paper does"))
        elif _pm.group(1).strip() != _cm.group(1).strip():
            findings.append(("contra", f"the {_label} disagrees between the paper and the "
                                       f"site — whitepaper.md says “{_pm.group(1)}”, "
                                       f"hugo.toml says “{_cm.group(1)}”"))

# ── 3d · no two consecutive authors from the same organization ────────────────
# A jointly published document is read for whose document it really is, and the
# author order is the first evidence. Surname order interleaves the current six
# (Docker, Snyk, Docker, Keycard, Snyk, Keycard); a seventh author, or a change
# of affiliation, can silently cluster two of one employer and undo it. Checking
# the rendered order rather than the YAML, because the template does the sort.
_ix = ROOT / "public" / "index.html"
if _ix.exists():
    _h = _ix.read_text(encoding="utf-8")
    _m = re.search(r"Drafted by(.*?)</p>", _h, re.S)
    if _m:
        _affs = re.findall(r'class=["\']?aff["\']?>\((.*?)\)', _m.group(1))
        for _a, _b in zip(_affs, _affs[1:]):
            if _a == _b:
                findings.append(("order", f"two consecutive authors from {_a} — "
                                          f"author order reads as a delegation, not a "
                                          f"joint document (see contributors.yaml)"))

# ── 4 · the tic list ─────────────────────────────────────────────────────────
TICS = ["which is what makes", "it is worth noting", "in order to", "leverage",
        "seamless", "robust", "cutting-edge", "at the end of the day",
        "that being said", "delve"]
for name, text in corpus.items():
    low = text.lower()
    for tic in TICS:
        if tic in low:
            findings.append(("tic", f"{name}: “{tic}”"))

order = {"contra": 0, "order": 1, "repeat": 2, "near": 3, "title": 4,
         "dash": 5, "tic": 6}
findings.sort(key=lambda f: order[f[0]])
print(f"copy: {len(corpus)} sources · {len(allsent)} sentences")
for kind, msg in findings:
    print(f"  {kind.upper():<7}{msg}")
print(f"\n{len(findings)} finding(s)")
sys.exit(1 if findings and STRICT else 0)
