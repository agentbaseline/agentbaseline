#!/usr/bin/env python3
"""
Visual regression gate for Figure 1.

Two earlier revisions shipped with colliding labels and a band running underneath
a terminal, and both passed a clean build. This checks the geometry the build
cannot see:

  1. no two text runs overlap
  2. no text run escapes the canvas
  3. every text run sits inside some box, not floating over a boundary
  4. the identifier ranges match controls.yaml

Run after every figure change. bin/snapshot does it automatically.
"""
import json, re, sys, pathlib

HERE = pathlib.Path(__file__).resolve().parents[1] / "whitepaper"
NAME = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else "figure-1"
BOXES = HERE / "figures" / f".{NAME}.boxes.json"
SVG = HERE / "figures" / f"{NAME}.svg"
CAT = HERE / "controls.yaml"

if not BOXES.exists():
    sys.exit("no box manifest — run whitepaper/figures/build-figure-1.py first")

boxes = json.loads(BOXES.read_text(encoding="utf-8"))
svg = SVG.read_text(encoding="utf-8")
errors = []

# canvas
vb = re.search(r'viewBox="0 0 (\d+) (\d+)"', svg)
W, H = int(vb.group(1)), int(vb.group(2))

def overlap(a, b):
    return not (a["x"] + a["w"] <= b["x"] + 0.5 or b["x"] + b["w"] <= a["x"] + 0.5
                or a["y"] + a["h"] <= b["y"] + 0.5 or b["y"] + b["h"] <= a["y"] + 0.5)

# 1. text-on-text collisions
for i, a in enumerate(boxes):
    for b in boxes[i + 1:]:
        if overlap(a, b):
            errors.append(
                f"text collision: {a['tag']!r} ({a['x']:.0f},{a['y']:.0f} "
                f"{a['w']:.0f}×{a['h']:.0f}) overlaps {b['tag']!r} "
                f"({b['x']:.0f},{b['y']:.0f} {b['w']:.0f}×{b['h']:.0f})")

# 2. escaping the canvas
for a in boxes:
    if a["x"] < 0 or a["y"] < 0 or a["x"] + a["w"] > W + 0.5 or a["y"] + a["h"] > H + 0.5:
        errors.append(f"text outside canvas: {a['tag']!r} at "
                      f"({a['x']:.0f},{a['y']:.0f}) {a['w']:.0f}×{a['h']:.0f}, canvas {W}×{H}")

# NOTE: containment and cell-in-band checks lived here. They were removed with
# the "no fills, no nested boxes" rewrite, which left them matching nothing while
# still printing a reassuring pass. If boxed elements return, so must they.

# 3c. no horizontal rule may cut through a text run — this is how the closing
#     rule ended up drawn above the last row's glosses.
hrules = [(float(x1), float(y), float(x2)) for x1, y, x2 in
          re.findall(r'<line x1="([\d.]+)" y1="([\d.]+)" x2="([\d.]+)" y2="\2"', svg)]
for a in boxes:
    for rx1, ry, rx2 in hrules:
        if a["y"] + 1 < ry < a["y"] + a["h"] - 1 and rx1 < a["x"] + a["w"] and a["x"] < rx2:
            errors.append(f"a rule crosses text: y={ry:.0f} cuts {a['tag']!r} "
                          f"({a['y']:.0f}..{a['y']+a['h']:.0f})")

# 4. identifier ranges agree with the source of truth
cat = CAT.read_text(encoding="utf-8")
hi = {}
for m in re.finditer(r"^  - id: (\w+)-(\d+)$", cat, re.M):
    hi[m.group(1)] = max(hi.get(m.group(1), 0), int(m.group(2)))
for fam, n in hi.items():
    want = f"{fam}-01…{n:02d}"
    if want not in svg:
        errors.append(f"identifier range missing or stale: expected {want}")

print(f"{NAME}: {W}×{H} · {len(boxes)} text runs")
for e in errors:
    print(f"  ERROR  {e}")
print(f"\n{len(errors)} error(s)")
sys.exit(1 if errors else 0)
